<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <!-- AppHost composition is exempt from deployable-closure boundaries; see the packages skill. -->
    <EnforceServiceBoundary>false</EnforceServiceBoundary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
    <PackageReference Include="Concertable.AppHost.Shared" />
    <PackageReference Include="Concertable.B2B.Concert.Contracts" />
    <PackageReference Include="Concertable.B2B.Artist.Contracts" />
    <PackageReference Include="Concertable.B2B.Venue.Contracts" />
  </ItemGroup>

</Project>
