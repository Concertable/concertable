{
  "name": "@concertable/mobile",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concertable/concertable.git",
    "directory": "app/mobile/shared"
  },
  "type": "module",
  "files": [
    "dist",
    "global.css",
    "nativewind-env.d.ts",
    "assets"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "prepack": "npm run build"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "react-native": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./global.css": "./global.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@concertable/shared": "*",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@microsoft/signalr": "^10.0.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@rn-primitives/avatar": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/separator": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@rn-primitives/tabs": "^1.4.0",
    "@stripe/stripe-react-native": "0.50.3",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "expo-auth-session": "~7.0.11",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.2.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-toast-message": "^2.2.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
    "expo": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.79.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo": "~54.0.33",
    "tsc-alias": "^1.9.1",
    "typescript": "~5.9.3"
  }
}
